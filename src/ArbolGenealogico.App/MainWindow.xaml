<Window x:Class="ArbolGenealogico.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArbolGenealogico.App"
        Title="Árbol genealógico" WindowStartupLocation="CenterScreen" Width="1320" Height="820" MinWidth="900" MinHeight="480"
        Background="{StaticResource FondoBrush}" FontFamily="{StaticResource Fuente}"
        Foreground="{StaticResource TextoBrush}" AllowDrop="True" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BordeBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AtrasBtn" Style="{StaticResource BotonIcono}" Content="&#xE72B;" Visibility="Collapsed"
                            ToolTip="Volver al árbol anterior (Alt+←)" Click="Atras_Click" Margin="0,0,6,0"/>
                    <StackPanel VerticalAlignment="Center" Margin="4,0,22,0" MinWidth="160">
                        <TextBlock x:Name="TituloTxt" FontSize="15.5" FontWeight="SemiBold" Text="Árbol genealógico"/>
                        <TextBlock x:Name="MigasTxt" FontSize="11.5" Foreground="{StaticResource TextoSuaveBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Button Style="{StaticResource BotonIcono}" Content="&#xE7C3;" ToolTip="Nuevo árbol (Ctrl+N)" Click="Nuevo_Click"/>
                    <Button Style="{StaticResource BotonIcono}" Content="&#xE8E5;" ToolTip="Abrir… (Ctrl+O)" Click="Abrir_Click"/>
                    <Button x:Name="GuardarBtn" Style="{StaticResource BotonIcono}" Content="&#xE74E;" ToolTip="Guardar (Ctrl+S)" Click="Guardar_Click"/>
                    <Button Style="{StaticResource BotonIcono}" Content="&#xE792;" ToolTip="Guardar como… (Ctrl+Mayús+S)" Click="GuardarComo_Click"/>
                    <Border Width="1" Height="22" Background="{StaticResource BordeBrush}" Margin="10,0"/>
                    <Button x:Name="DeshacerBtn" Style="{StaticResource BotonIcono}" Content="&#xE7A7;" ToolTip="Deshacer (Ctrl+Z)" Click="Deshacer_Click"/>
                    <Button x:Name="RehacerBtn" Style="{StaticResource BotonIcono}" Content="&#xE7A6;" ToolTip="Rehacer (Ctrl+Y)" Click="Rehacer_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border CornerRadius="10" Margin="0,0,12,0" Background="{StaticResource FondoBrush}"
                            BorderBrush="{StaticResource BordeBrush}" BorderThickness="1" VerticalAlignment="Center"
                            ToolTip="Cómo se coloca el árbol (Ctrl+L pasa a la siguiente)">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="OrdenacionA" Style="{StaticResource Segmento}" Content="Compacto" Focusable="False"
                                         GroupName="Ordenacion" Checked="Ordenacion_Checked"/>
                            <RadioButton x:Name="OrdenacionB" Style="{StaticResource Segmento}" Content="Lateral" Focusable="False"
                                         GroupName="Ordenacion" Checked="Ordenacion_Checked"/>
                            <RadioButton x:Name="OrdenacionC" Style="{StaticResource Segmento}" Content="Balanceado" Focusable="False"
                                         GroupName="Ordenacion" IsChecked="True" Checked="Ordenacion_Checked"/>
                            <RadioButton x:Name="OrdenacionD" Style="{StaticResource Segmento}" Content="Escalonado" Focusable="False"
                                         GroupName="Ordenacion" Checked="Ordenacion_Checked"
                                         ToolTip="Lo más estrecho posible, con las familias escalonadas: para imprimir el árbol en una hoja"/>
                            <RadioButton x:Name="OrdenacionE" Style="{StaticResource Segmento}" Content="Bowtie" Focusable="False"
                                         GroupName="Ordenacion" Checked="Ordenacion_Checked"
                                         ToolTip="Solo los antepasados, en pajarita: los del padre a la izquierda y los de la madre a la derecha"/>
                        </StackPanel>
                    </Border>
                    <!-- Icono dibujado: una tarjeta estrecha, con la foto arriba y las líneas del nombre debajo -->
                    <Button x:Name="EstrechasBtn" Style="{StaticResource BotonIcono}" Margin="0,0,10,0"
                            ToolTip="Tarjetas estrechas, con la foto encima del nombre (Ctrl+T)" Click="Estrechas_Click">
                        <Canvas Width="14" Height="19" SnapsToDevicePixels="True">
                            <Rectangle Canvas.Left="0.7" Canvas.Top="0.7" Width="12.6" Height="17.6" RadiusX="2.6" RadiusY="2.6" StrokeThickness="1.4"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <Ellipse Canvas.Left="4" Canvas.Top="3.4" Width="6" Height="6" StrokeThickness="1.3"
                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <Line X1="3.8" Y1="12.4" X2="10.2" Y2="12.4" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <Line X1="5" Y1="15" X2="9" Y2="15" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Canvas>
                    </Button>
                    <Border x:Name="BusquedaBorde" Width="220" Height="36" CornerRadius="10" Margin="0,0,8,0"
                            Background="{StaticResource FondoBrush}" BorderBrush="{StaticResource BordeBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Iconos}" FontSize="14" Foreground="{StaticResource TextoSuaveBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox x:Name="BuscarBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0,8,4,0" FontSize="13"
                                     TextChanged="BuscarBox_TextChanged" KeyDown="BuscarBox_KeyDown"
                                     GotKeyboardFocus="BuscarBox_FocoCambia" LostKeyboardFocus="BuscarBox_FocoCambia"/>
                            <TextBlock x:Name="BuscarPlaceholder" Grid.Column="1" Text="Buscar persona…  (Ctrl+F)" IsHitTestVisible="False"
                                       Foreground="#5B6379" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BuscarContador" Grid.Column="2" FontSize="11.5" Foreground="{StaticResource TextoSuaveBrush}"
                                       VerticalAlignment="Center" Margin="0,0,4,0" IsHitTestVisible="False"/>
                            <Button x:Name="BuscarLimpiar" Grid.Column="3" Style="{StaticResource BotonIcono}" Content="&#xE711;" FontSize="11"
                                    Width="26" Height="26" Visibility="Collapsed" Click="BuscarLimpiar_Click" ToolTip="Borrar la búsqueda (Esc)"/>
                        </Grid>
                    </Border>
                    <Button Style="{StaticResource BotonIcono}" Content="&#xE77B;" ToolTip="Ir a la persona principal (Inicio)" Click="CentrarPrincipal_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Lienzo -->
        <Grid Grid.Row="1">
            <local:VistaArbol x:Name="Vista"/>

            <TextBlock x:Name="AyudaTxt" Foreground="#5B6379" FontSize="12" Margin="18,0,0,14" VerticalAlignment="Bottom" HorizontalAlignment="Left" IsHitTestVisible="False"
                       Text="Flechas: moverse   ·   Intro: editar   ·   Ins o +: añadir   ·   Supr: eliminar   ·   Ctrl+F: buscar   ·   F1: atajos"/>

            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,276,16" CornerRadius="12"
                    Background="#E613161E" BorderBrush="{StaticResource BordeBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Margin="3">
                    <Button Style="{StaticResource BotonIcono}" Content="&#xE71F;" ToolTip="Alejar (−)" Click="Alejar_Click" Width="34" Height="32"/>
                    <Button Style="{StaticResource BotonIcono}" Content="&#xE8A3;" ToolTip="Acercar (+)" Click="Acercar_Click" Width="34" Height="32"/>
                    <Button Style="{StaticResource BotonIcono}" Content="&#xE740;" ToolTip="Ver todo el árbol (Ctrl+0)" Click="Ajustar_Click" Width="34" Height="32"/>
                </StackPanel>
            </Border>

            <local:MiniMapa x:Name="Mini" Width="244" Height="168" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16"/>
        </Grid>
    </Grid>
</Window>
