<Window x:Class="ArbolGenealogico.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArbolGenealogico.App"
        Title="Árbol genealógico" WindowStartupLocation="CenterScreen" Width="1320" Height="820" MinWidth="900" MinHeight="480"
        Background="{StaticResource FondoBrush}" FontFamily="{StaticResource Fuente}"
        Foreground="{StaticResource TextoBrush}" AllowDrop="True" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BordeBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AtrasBtn" Style="{StaticResource BotonIcono}" Content="&#xE72B;" Visibility="Collapsed"
                            ToolTip="Volver al árbol anterior (Alt+←)" Click="Atras_Click" Margin="0,0,6,0"/>
                    <StackPanel VerticalAlignment="Center" Margin="4,0,22,0" MinWidth="160">
                        <TextBlock x:Name="TituloTxt" FontSize="15.5" FontWeight="SemiBold" Text="Árbol genealógico"/>
                        <TextBlock x:Name="MigasTxt" FontSize="11.5" Foreground="{StaticResource TextoSuaveBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Button Style="{StaticResource BotonIcono}" Content="&#xE7C3;" ToolTip="Nuevo árbol (Ctrl+N)" Click="Nuevo_Click"/>
                    <Button Style="{StaticResource BotonIcono}" Content="&#xE8E5;" ToolTip="Abrir… (Ctrl+O)" Click="Abrir_Click"/>
                    <Button x:Name="GuardarBtn" Style="{StaticResource BotonIcono}" Content="&#xE74E;" ToolTip="Guardar (Ctrl+S)" Click="Guardar_Click"/>
                    <Button Style="{StaticResource BotonIcono}" Content="&#xE792;" ToolTip="Guardar como… (Ctrl+Mayús+S)" Click="GuardarComo_Click"/>
                    <Border Width="1" Height="22" Background="{StaticResource BordeBrush}" Margin="10,0"/>
                    <Button x:Name="DeshacerBtn" Style="{StaticResource BotonIcono}" Content="&#xE7A7;" ToolTip="Deshacer (Ctrl+Z)" Click="Deshacer_Click"/>
                    <Button x:Name="RehacerBtn" Style="{StaticResource BotonIcono}" Content="&#xE7A6;" ToolTip="Rehacer (Ctrl+Y)" Click="Rehacer_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border CornerRadius="10" Margin="0,0,12,0" Background="{StaticResource FondoBrush}"
                            BorderBrush="{StaticResource BordeBrush}" BorderThickness="1" VerticalAlignment="Center"
                            ToolTip="Cómo se coloca el árbol (Ctrl+L pasa a la siguiente)">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="OrdenacionA" Style="{StaticResource Segmento}" Content="Compacto" Focusable="False"
                                         GroupName="Ordenacion" Checked="Ordenacion_Checked"/>
                            <RadioButton x:Name="OrdenacionB" Style="{StaticResource Segmento}" Content="Lateral" Focusable="False"
                                         GroupName="Ordenacion" Checked="Ordenacion_Checked"/>
                            <RadioButton x:Name="OrdenacionC" Style="{StaticResource Segmento}" Content="Balanceado" Focusable="False"
                                         GroupName="Ordenacion" IsChecked="True" Checked="Ordenacion_Checked"/>
                            <RadioButton x:Name="OrdenacionD" Style="{StaticResource Segmento}" Content="Escalonado" Focusable="False"
                                         GroupName="Ordenacion" Checked="Ordenacion_Checked"
                                         ToolTip="Lo más estrecho posible, con las familias escalonadas: para imprimir el árbol en una hoja"/>
                        </StackPanel>
                    </Border>
                    <!-- Icono dibujado: una hoja vertical y otra horizontal superpuestas -->
                    <Button x:Name="GuiaBtn" Style="{StaticResource BotonIcono}" Content="&#xE749;"
                            ToolTip="Imprimir: ver cómo quedaría el árbol en hojas A4 a A1 y prepararlas (Ctrl+H)" Click="Guia_Click"/>
                    <!-- Forma de las tarjetas: el icono (dibujado en el código) es la tarjeta elegida; al pulsar se abre el panel con las tres opciones -->
                    <Button x:Name="TarjetasBtn" Style="{StaticResource BotonIcono}" Margin="0,0,10,0" Click="Tarjetas_Click"
                            ToolTip="Forma de las tarjetas: horizontal o vertical, con foto o sin ella, con tarjeta o sin ella">
                        <Canvas x:Name="TarjetasIcono" Width="20" Height="20" SnapsToDevicePixels="True"/>
                    </Button>
                    <Popup x:Name="TarjetasPopup" PlacementTarget="{Binding ElementName=TarjetasBtn}" Placement="Bottom" StaysOpen="False"
                           AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6">
                        <Border CornerRadius="12" Background="#F213161E" BorderBrush="{StaticResource BordeBrush}" BorderThickness="1" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="Forma" VerticalAlignment="Center" Foreground="{StaticResource TextoSuaveBrush}" FontSize="12.5" Margin="0,0,10,0"/>
                                <RadioButton x:Name="TarjetaHorizontal" Grid.Column="1" Style="{StaticResource Segmento}" Content="Horizontal" GroupName="TarjetaForma" Focusable="False" Checked="Tarjeta_Checked"
                                             ToolTip="La foto a la izquierda del nombre (Ctrl+T cambia)"/>
                                <RadioButton x:Name="TarjetaVertical" Grid.Column="2" Style="{StaticResource Segmento}" Content="Vertical" GroupName="TarjetaForma" Focusable="False" Checked="Tarjeta_Checked"
                                             ToolTip="La foto encima del nombre, y el nombre y los apellidos en dos líneas si hace falta: el árbol sale más estrecho (Ctrl+T cambia)"/>
                                <TextBlock Grid.Row="1" Text="Foto" VerticalAlignment="Center" Foreground="{StaticResource TextoSuaveBrush}" FontSize="12.5" Margin="0,0,10,0"/>
                                <RadioButton x:Name="TarjetaConFoto" Grid.Row="1" Grid.Column="1" Style="{StaticResource Segmento}" Content="Con foto" GroupName="TarjetaFoto" Focusable="False" Checked="Tarjeta_Checked"
                                             ToolTip="Con la foto (o las iniciales) y el símbolo de su sexo (Ctrl+Mayús+F cambia)"/>
                                <RadioButton x:Name="TarjetaSinFoto" Grid.Row="1" Grid.Column="2" Style="{StaticResource Segmento}" Content="Sin foto" GroupName="TarjetaFoto" Focusable="False" Checked="Tarjeta_Checked"
                                             ToolTip="Sin foto: tarjetas más pequeñas, con una franja del color de su sexo (Ctrl+Mayús+F cambia)"/>
                                <TextBlock Grid.Row="2" Text="Tarjeta" VerticalAlignment="Center" Foreground="{StaticResource TextoSuaveBrush}" FontSize="12.5" Margin="0,0,10,0"/>
                                <RadioButton x:Name="ConTarjeta" Grid.Row="2" Grid.Column="1" Style="{StaticResource Segmento}" Content="Con tarjeta" GroupName="TarjetaFondo" Focusable="False" Checked="Tarjeta_Checked"
                                             ToolTip="Cada persona en su tarjeta, con el fondo y el borde de su color (Ctrl+Mayús+T cambia)"/>
                                <RadioButton x:Name="SinTarjeta" Grid.Row="2" Grid.Column="2" Style="{StaticResource Segmento}" Content="Sin tarjeta" GroupName="TarjetaFondo" Focusable="False" Checked="Tarjeta_Checked"
                                             ToolTip="Solo el nombre (y la foto si la lleva), del color de su sexo: el sitio de la tarjeta queda para la letra (Ctrl+Mayús+T cambia)"/>
                            </Grid>
                        </Border>
                    </Popup>
                    <Border x:Name="BusquedaBorde" Width="220" Height="36" CornerRadius="10" Margin="0,0,8,0"
                            Background="{StaticResource FondoBrush}" BorderBrush="{StaticResource BordeBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Iconos}" FontSize="14" Foreground="{StaticResource TextoSuaveBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox x:Name="BuscarBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0,8,4,0" FontSize="13"
                                     TextChanged="BuscarBox_TextChanged" KeyDown="BuscarBox_KeyDown"
                                     GotKeyboardFocus="BuscarBox_FocoCambia" LostKeyboardFocus="BuscarBox_FocoCambia"/>
                            <TextBlock x:Name="BuscarPlaceholder" Grid.Column="1" Text="Buscar persona…  (Ctrl+F)" IsHitTestVisible="False"
                                       Foreground="#5B6379" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BuscarContador" Grid.Column="2" FontSize="11.5" Foreground="{StaticResource TextoSuaveBrush}"
                                       VerticalAlignment="Center" Margin="0,0,4,0" IsHitTestVisible="False"/>
                            <Button x:Name="BuscarLimpiar" Grid.Column="3" Style="{StaticResource BotonIcono}" Content="&#xE711;" FontSize="11"
                                    Width="26" Height="26" Visibility="Collapsed" Click="BuscarLimpiar_Click" ToolTip="Borrar la búsqueda (Esc)"/>
                        </Grid>
                    </Border>
                    <Button Style="{StaticResource BotonIcono}" Content="&#xE77B;" ToolTip="Ir a la persona principal (Inicio)" Click="CentrarPrincipal_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Lienzo -->
        <Grid Grid.Row="1">
            <local:VistaArbol x:Name="Vista"/>

            <TextBlock x:Name="AyudaTxt" Foreground="#5B6379" FontSize="12" Margin="18,0,0,14" VerticalAlignment="Bottom" HorizontalAlignment="Left" IsHitTestVisible="False"
                       Text="Flechas: moverse   ·   Intro: editar   ·   Ins o +: añadir   ·   Supr: eliminar   ·   Ctrl+F: buscar   ·   F1: atajos"/>

            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,276,16" CornerRadius="12"
                    Background="#E613161E" BorderBrush="{StaticResource BordeBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Margin="3">
                    <Button Style="{StaticResource BotonIcono}" Content="&#xE71F;" ToolTip="Alejar (−)" Click="Alejar_Click" Width="34" Height="32"/>
                    <Button Style="{StaticResource BotonIcono}" Content="&#xE8A3;" ToolTip="Acercar (+)" Click="Acercar_Click" Width="34" Height="32"/>
                    <Button Style="{StaticResource BotonIcono}" Content="&#xE740;" ToolTip="Ver todo el árbol (Ctrl+0)" Click="Ajustar_Click" Width="34" Height="32"/>
                </StackPanel>
            </Border>

            <!-- Guía de impresión: papel y número de hojas; se muestra la mejor forma de colocarlas -->
            <Border x:Name="GuiaPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,16,0,0" CornerRadius="12"
                    Background="#E613161E" BorderBrush="{StaticResource BordeBrush}" BorderThickness="1" Padding="12,8" Visibility="Collapsed">
                <StackPanel>
                    <!-- Cada grupo de opciones va en su pastilla, con su nombre fuera: así el nombre no parece otra opción -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Papel" VerticalAlignment="Center" Foreground="{StaticResource TextoSuaveBrush}" FontSize="12.5" Margin="0,0,8,0"/>
                        <Border CornerRadius="10" Background="{StaticResource FondoBrush}" BorderBrush="{StaticResource BordeBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="PapelA4" Style="{StaticResource Segmento}" Content="A4" GroupName="Papel" Focusable="False" Checked="Guia_Opcion"/>
                                <RadioButton x:Name="PapelA3" Style="{StaticResource Segmento}" Content="A3" GroupName="Papel" Focusable="False" Checked="Guia_Opcion"/>
                                <RadioButton x:Name="PapelA2" Style="{StaticResource Segmento}" Content="A2" GroupName="Papel" Focusable="False" Checked="Guia_Opcion"/>
                                <RadioButton x:Name="PapelA1" Style="{StaticResource Segmento}" Content="A1" GroupName="Papel" Focusable="False" Checked="Guia_Opcion"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Hojas" VerticalAlignment="Center" Foreground="{StaticResource TextoSuaveBrush}" FontSize="12.5" Margin="18,0,8,0"/>
                        <Border CornerRadius="10" Background="{StaticResource FondoBrush}" BorderBrush="{StaticResource BordeBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Hojas1" Style="{StaticResource Segmento}" Content="1" GroupName="Hojas" Focusable="False" Checked="Guia_Opcion" Padding="0"/>
                                <RadioButton x:Name="Hojas2" Style="{StaticResource Segmento}" Content="2" GroupName="Hojas" Focusable="False" Checked="Guia_Opcion" Padding="0"/>
                                <RadioButton x:Name="Hojas3" Style="{StaticResource Segmento}" Content="3" GroupName="Hojas" Focusable="False" Checked="Guia_Opcion" Padding="0"/>
                                <RadioButton x:Name="Hojas4" Style="{StaticResource Segmento}" Content="4" GroupName="Hojas" Focusable="False" Checked="Guia_Opcion" Padding="0"/>
                                <RadioButton x:Name="Hojas5" Style="{StaticResource Segmento}" Content="5" GroupName="Hojas" Focusable="False" Checked="Guia_Opcion" Padding="0"/>
                                <RadioButton x:Name="Hojas6" Style="{StaticResource Segmento}" Content="6" GroupName="Hojas" Focusable="False" Checked="Guia_Opcion" Padding="0"/>
                                <RadioButton x:Name="Hojas7" Style="{StaticResource Segmento}" Content="7" GroupName="Hojas" Focusable="False" Checked="Guia_Opcion" Padding="0"/>
                                <RadioButton x:Name="Hojas8" Style="{StaticResource Segmento}" Content="8" GroupName="Hojas" Focusable="False" Checked="Guia_Opcion" Padding="0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Tarjetas" VerticalAlignment="Center" Foreground="{StaticResource TextoSuaveBrush}" FontSize="12.5" Margin="0,0,8,0"/>
                        <Border x:Name="EstiloImpresion" CornerRadius="10" Background="{StaticResource FondoBrush}" BorderBrush="{StaticResource BordeBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ImpresionClara" Style="{StaticResource Segmento}" Content="Claras" GroupName="Estilo" Focusable="False" Checked="Estilo_Opcion"
                                             ToolTip="Tarjetas blancas con el borde de su color: gastan poca tinta"/>
                                <RadioButton x:Name="ImpresionOscura" Style="{StaticResource Segmento}" Content="Oscuras" GroupName="Estilo" Focusable="False" Checked="Estilo_Opcion"
                                             ToolTip="Las tarjetas como en pantalla, con fondo de color (gastan mucha tinta)"/>
                            </StackPanel>
                        </Border>
                        <CheckBox x:Name="NoCortarTarjetas" Style="{StaticResource Casilla}" Content="No cortar tarjetas" Focusable="False" Margin="16,0,0,0"
                                  Checked="Guia_Opcion" Unchecked="Guia_Opcion"
                                  ToolTip="Que los cortes entre hojas pasen por huecos entre tarjetas, para no partir ninguna al recortar y pegar (el árbol puede salir algo más pequeño)"/>
                    </StackPanel>
                    <Grid Margin="2,6,0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="GuiaTxt" Foreground="#6FB7FF" FontSize="12.5"/>
                            <TextBlock Foreground="{StaticResource TextoSuaveBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="460" HorizontalAlignment="Left"
                                       Text="La letra se mide como en Word: un libro usa 10 a 12 pt. Para que salga más grande: más papel u hojas, o tarjetas sin foto o sin tarjeta. Cada hoja deja un margen de 12 mm. Para juntarlas, se recorta la hoja por su línea de corte y se pega sobre el margen gris de la anterior: el dibujo sigue sin cortes."/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource BotonPrimario}" Content="Imprimir…" Margin="12,0,0,0" VerticalAlignment="Center"
                                Click="Imprimir_Click" ToolTip="Imprimir las hojas, listas para recortar y pegar (Ctrl+P)"/>
                    </Grid>
                </StackPanel>
            </Border>

            <local:MiniMapa x:Name="Mini" Width="244" Height="168" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16"/>
        </Grid>
    </Grid>
</Window>
