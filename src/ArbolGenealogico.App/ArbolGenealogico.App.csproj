<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ArbolGenealogico.Core\ArbolGenealogico.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ArbolGenealogico</AssemblyName>
    <RootNamespace>ArbolGenealogico.App</RootNamespace>
    <ApplicationIcon>Recursos\icono.ico</ApplicationIcon>
    <Product>Árbol Genealógico</Product>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Al publicar autocontenido para win-x64 (ver README): un solo .exe comprimido, unos 60 MB en vez de 125. -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- la compresión solo existe en el autocontenido (en el ligero, sin .NET dentro, no hace falta) -->
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Recursos\icono.png" />
  </ItemGroup>

</Project>
