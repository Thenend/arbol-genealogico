<Project Sdk="Microsoft.NET.Sdk">

  <!-- La aplicación para Android. Todo lo que se ve está en ArbolGenealogico.Movil; aquí solo lo propio de Android:
       recibir archivos de otras aplicaciones, el menú «Compartir» y la cámara. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
    <ApplicationId>com.thenend.arbolgenealogico</ApplicationId>
    <ApplicationTitle>Ramo</ApplicationTitle>
    <ApplicationVersion>3</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.2</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- También 32 bits (armeabi-v7a): muchos móviles baratos (p. ej. Galaxy A13) llevan Android de 32 bits aunque el
         procesador sea de 64, y sin esto Google Play los da por no compatibles. -->
    <RuntimeIdentifiers>android-arm;android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- La versión de prueba, «Ramo Pruebas»: otro paquete (….prueba), para instalarla junto a la de Google Play sin
       tocarla. Es la de Debug y la de -p:Pruebas=true (en Release, para probarla tal como irá); la de la tienda es la de
       Release sin nada más. No usa Google Play (la compra solo vale para el paquete de la tienda), sino una tienda de
       mentira, y su copia va a Documentos/Ramo Pruebas. -->
  <PropertyGroup>
    <Pruebas Condition="'$(Pruebas)' == '' and '$(Configuration)' != 'Release'">true</Pruebas>
    <NombreApp>Ramo</NombreApp>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Pruebas)' == 'true'">
    <ApplicationId>$(ApplicationId).prueba</ApplicationId>
    <ApplicationTitle>Ramo Pruebas</ApplicationTitle>
    <NombreApp>Ramo Pruebas</NombreApp>
    <DefineConstants>$(DefineConstants);PRUEBAS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <AndroidManifestPlaceholders>nombreApp=$(NombreApp)</AndroidManifestPlaceholders>
  </PropertyGroup>

  <!-- -p:TemaAlbum=true: la variante que empieza con el tema Álbum (ver ArbolGenealogico.Movil.csproj); aquí, el fondo al
       abrirla y el de las barras del sistema, color Álbum en vez del verde de Jardín. -->
  <ItemGroup Condition="'$(TemaAlbum)' == 'true'">
    <AndroidResource Remove="Resources\values\fondo.xml" />
    <AndroidResource Include="VarianteAlbum\fondo.xml" Link="Resources\values\fondo.xml" />
  </ItemGroup>

  <!-- -p:SinTienda=true: sin Google Play Billing, con todo incluido (para instalarla uno mismo, fuera de la tienda). -->
  <PropertyGroup Condition="'$(SinTienda)' == 'true'">
    <DefineConstants>$(DefineConstants);SIN_TIENDA</DefineConstants>
  </PropertyGroup>

  <!-- Para Google Play: un .aab firmado (dotnet publish -c Release -p:AndroidPackageFormat=aab …, ver ANDROID.md). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Xamarin.Android.Google.BillingClient" Version="9.1.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArbolGenealogico.Movil\ArbolGenealogico.Movil.csproj" />
  </ItemGroup>
</Project>
