<?xml version="1.0" encoding="utf-8"?>
<!-- Sin permiso de internet: la aplicación no se conecta a nada. Los árboles entran y salen como archivos. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="auto">
  <application android:label="Ramo" android:icon="@mipmap/icono" android:allowBackup="true">
    <provider android:name="androidx.core.content.FileProvider"
              android:authorities="${applicationId}.archivos"
              android:exported="false"
              android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/rutas_compartidas" />
    </provider>
  </application>
  <queries>
    <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
  </queries>
</manifest>
