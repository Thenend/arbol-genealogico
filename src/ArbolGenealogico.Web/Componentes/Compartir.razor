@* Quién tiene acceso a un árbol. El propietario invita por correo y decide quién puede editar y quién solo ver. *@
@inject Datos Datos
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="fondo-dialogo" @onpointerdown="AlCerrar">
    <div class="dialogo ancho" @onpointerdown:stopPropagation>
        <div class="cab"><h2>@(Propietario ? "Compartir con la familia" : "Quién tiene acceso")</h2></div>
        <div class="contenido">
            @if (Propietario)
            {
                <p>Elige a alguien de la familia (los que ya usan la web) o escribe el correo de quien aún no tiene cuenta: cuando entre con ese correo verá este árbol en «Mis árboles».</p>
            }
            @if (_solicitudes is { Count: > 0 })
            {
                <div class="aviso ok" style="margin-bottom:12px">
                    <b>Te piden acceso</b>
                    <ul class="miembros" style="margin:6px 0 0">
                        @foreach (var sol in _solicitudes)
                        {
                            var ss = sol;
                            <li>
                                <span class="email">@sol.Quien@if (!string.IsNullOrWhiteSpace(sol.Mensaje)) {<span class="pend">«@sol.Mensaje»</span>}</span>
                                <button class="boton primario" disabled="@_ocupado" @onclick='() => Aceptar(ss, "editor")'>Que pueda editar</button>
                                <button class="boton borde" disabled="@_ocupado" @onclick='() => Aceptar(ss, "lector")'>Solo ver</button>
                                <button class="boton peligro" disabled="@_ocupado" @onclick="() => Rechazar(ss)">Rechazar</button>
                            </li>
                        }
                    </ul>
                </div>
            }
            @if (_error != null) { <div class="aviso error" style="margin-bottom:12px">@_error</div> }
            @if (_miembros == null)
            {
                <p class="suave">Cargando…</p>
            }
            else
            {
                <ul class="miembros">
                    @foreach (var m in _miembros)
                    {
                        var mm = m;
                        <li>
                            <span class="email">
                                @NombreDe(m.Email)@(m.Email == Datos.Actual?.Email ? " (tú)" : "")
                                @if (NombreDe(m.Email) != m.Email) { <span class="pend">@m.Email</span> }
                                @if (m.Pendiente) { <span class="pend">Invitado: aún no ha entrado</span> }
                            </span>
                            @if (Propietario && m.Rol != "propietario")
                            {
                                <select value="@m.Rol" @onchange="e => CambiarRol(mm, e.Value?.ToString() ?? mm.Rol)">
                                    <option value="editor">Puede editar</option>
                                    <option value="lector">Solo ver</option>
                                </select>
                                <button class="boton icono peligro" title="Quitar acceso" @onclick="() => Quitar(mm)">@Iconos.Cerrar</button>
                            }
                            else
                            {
                                <span class="suave">@Nombres.Rol(m.Rol)</span>
                            }
                        </li>
                    }
                </ul>
            }
            @if (Propietario)
            {
                <form class="invitar" @onsubmit="Invitar" @onsubmit:preventDefault>
                    <input type="text" list="familia-compartir" placeholder="Nombre o correo" autocomplete="off" @bind="_email" />
                    <datalist id="familia-compartir">
                        @foreach (var p in Candidatos())
                        {
                            <option value="@p.Email">@p.Mostrar</option>
                        }
                    </datalist>
                    <select @bind="_rol">
                        <option value="editor">Puede editar</option>
                        <option value="lector">Solo ver</option>
                    </select>
                    <button type="submit" class="boton primario" disabled="@_ocupado">Compartir</button>
                </form>
                <label class="interruptor" style="margin-top:14px">
                    <input type="checkbox" checked="@_visible" @onchange="CambiarVisible" />
                    <span>Que la familia vea en «Familia y amigos» que existe este árbol y pueda pedirte acceso<span class="pend suave" style="display:block; font-size:12px">Solo se ven su nombre y cuántas personas tiene, no su contenido.</span></span>
                </label>
                <p class="suave" style="margin-top:14px">
                    Envíales este enlace (por WhatsApp, correo…) para que entren:
                </p>
                <div style="display:flex; gap:8px; align-items:center">
                    <input type="text" readonly value="@Nav.BaseUri" />
                    <button class="boton borde" @onclick="Copiar">@(_copiado ? "Copiado" : "Copiar")</button>
                </div>
            }
        </div>
        <div class="pie"><button class="boton primario" @onclick="AlCerrar">Hecho</button></div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string ArbolId { get; set; } = "";
    [Parameter] public bool Propietario { get; set; }
    [Parameter] public EventCallback AlCerrar { get; set; }

    private List<Miembro>? _miembros;
    private List<PersonaDirectorio> _directorio = new();
    private List<Solicitud>? _solicitudes;
    private bool _visible = true;
    private string _email = "", _rol = "editor";
    private string? _error;
    private bool _ocupado, _copiado;

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
        if (Datos.Local) return;
        try
        {
            _directorio = await Datos.Directorio();
            if (Propietario) _visible = await Datos.EsVisible(ArbolId);
        }
        catch { /* sin directorio: se invita por correo */ }
    }

    private string NombreDe(string email) =>
        _directorio.FirstOrDefault(p => p.Email.Equals(email, StringComparison.OrdinalIgnoreCase)) is { } p ? p.Mostrar : email;

    /// <summary>Los usuarios de la web que aún no tienen acceso a este árbol.</summary>
    private IEnumerable<PersonaDirectorio> Candidatos() =>
        _directorio.Where(p => _miembros?.Any(m => !m.Pendiente && m.Email.Equals(p.Email, StringComparison.OrdinalIgnoreCase)) != true);

    private async Task Aceptar(Solicitud s, string rol)
    {
        _ocupado = true;
        _error = await Datos.CompartirCon(ArbolId, s.Usuario, rol);
        _ocupado = false;
        await Cargar();
    }

    private async Task Rechazar(Solicitud s)
    {
        _ocupado = true;
        _error = await Datos.RechazarSolicitud(ArbolId, s.Usuario);
        _ocupado = false;
        await Cargar();
    }

    private async Task CambiarVisible(ChangeEventArgs e)
    {
        var v = e.Value is true;
        _error = await Datos.PonerVisible(ArbolId, v);
        if (_error == null) _visible = v;
    }

    private async Task Cargar()
    {
        try
        {
            _miembros = await Datos.Miembros(ArbolId);
            if (Propietario && !Datos.Local)
                try { _solicitudes = (await Datos.MisSolicitudes()).Where(x => x.ArbolId == ArbolId).ToList(); } catch { _solicitudes = null; }
        }
        catch (Exception e) { _error = e.Texto(); _miembros = new(); }
    }

    private async Task Invitar()
    {
        _error = null;
        var texto = _email.Trim();
        var persona = _directorio.FirstOrDefault(p => p.Email.Equals(texto, StringComparison.OrdinalIgnoreCase))
                   ?? _directorio.Where(p => !string.IsNullOrWhiteSpace(p.Nombre) && Texto.Normalizar(p.Nombre) == Texto.Normalizar(texto)).SingleOrDefaultOrNull();
        if (persona != null && persona.Usuario != Datos.Actual?.Id)
        {
            _ocupado = true;
            _error = await Datos.CompartirCon(ArbolId, persona.Usuario, _rol);
            _ocupado = false;
            if (_error == null) { _email = ""; await Cargar(); }
            return;
        }
        var email = texto.ToLowerInvariant();
        if (!email.Contains('@') || email.Contains(' ')) { _error = "No hay nadie con ese nombre en la web: elige a alguien de la lista o escribe su correo."; return; }
        if (_miembros?.Any(m => m.Email.Equals(email, StringComparison.OrdinalIgnoreCase) && !m.Pendiente) == true) { _error = "Esa persona ya tiene acceso."; return; }
        _ocupado = true;
        _error = await Datos.Invitar(ArbolId, email, _rol);
        _ocupado = false;
        if (_error == null) { _email = ""; await Cargar(); }
    }

    private async Task CambiarRol(Miembro m, string rol)
    {
        _error = await Datos.CambiarRol(ArbolId, m, rol);
        await Cargar();
    }

    private async Task Quitar(Miembro m)
    {
        _error = await Datos.Quitar(ArbolId, m);
        await Cargar();
    }

    private async Task Copiar()
    {
        await using var v = await JS.InvokeAsync<IJSObjectReference>("import", "./js/vista.js");
        _copiado = await v.InvokeAsync<bool>("copiar", Nav.BaseUri);
    }
}
