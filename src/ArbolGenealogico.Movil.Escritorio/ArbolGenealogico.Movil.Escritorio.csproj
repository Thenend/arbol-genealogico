<Project Sdk="Microsoft.NET.Sdk">

  <!-- La aplicación del móvil en una ventana de Windows, para probarla sin teléfono (y sacar capturas con la opción captura). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArbolGenealogico.Movil\ArbolGenealogico.Movil.csproj" />
  </ItemGroup>
</Project>
